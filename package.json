{
  "name": "liteclient",
  "version": "0.7.1",
  "publisher": "liteclienthq",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "displayName": "LiteClient",
  "description": "Fast, lightweight REST API client with native VS Code UX. No account, no bloat, no telemetry.",
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "rest",
    "http",
    "client",
    "api",
    "postman",
    "thunder-client",
    "request",
    "testing"
  ],
  "icon": "media/logo.png",
  "bugs": {
    "url": "https://github.com/liteclienthq/liteclient/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liteclienthq/liteclient.git"
  },
  "homepage": "https://liteclient.com",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "liteclient.requestEditor",
        "displayName": "LiteClient Request",
        "selector": [
          {
            "filenamePattern": "*.lcreq"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liteclient-sidebar",
          "title": "LiteClient",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "liteclient-sidebar": [
        {
          "type": "webview",
          "id": "liteclient-sidebar-view",
          "name": "LiteClient",
          "icon": "media/logo.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "liteclient.newRequest",
        "title": "New Request",
        "icon": "$(new-file)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.newCollection",
        "title": "New Collection",
        "icon": "$(new-folder)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.newEnvironment",
        "title": "New Environment",
        "icon": "$(new-folder)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.addCollection",
        "title": "Add Collection",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.renameCollection",
        "title": "Rename Collection",
        "icon": "$(edit)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.deleteCollection",
        "title": "Delete Collection",
        "icon": "$(trash)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.addRequestToCollection",
        "title": "Add Request to Collection",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.renameCollectionRequest",
        "title": "Rename",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.deleteRequestFromCollection",
        "title": "Delete Request from Collection",
        "icon": "$(trash)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.addEnvironment",
        "title": "Add Environment",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.renameEnvironment",
        "title": "Rename Environment",
        "icon": "$(edit)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.deleteEnvironment",
        "title": "Delete Environment",
        "icon": "$(trash)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.addVariableToEnvironment",
        "title": "Add Variable",
        "icon": "$(add)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.editVariable",
        "title": "Edit Variable",
        "icon": "$(edit)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.deleteVariable",
        "title": "Delete Variable",
        "icon": "$(trash)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.openHistoryRequest",
        "title": "Open History Request",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.deleteHistoryItem",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "LiteClient"
      },
      {
        "command": "liteclient.clearHistory",
        "title": "Clear History",
        "icon": "$(trash)",
        "category": "LiteClient"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "liteclient.newRequest",
          "when": "view == requests",
          "group": "navigation"
        },
        {
          "command": "liteclient.newCollection",
          "when": "view == collections",
          "group": "navigation"
        },
        {
          "command": "liteclient.newEnvironment",
          "when": "view == environments",
          "group": "navigation"
        },
        {
          "command": "liteclient.clearHistory",
          "when": "view == requests"
        }
      ],
      "view/item/context": [
        {
          "when": "view == collections && viewItem == collection",
          "command": "liteclient.deleteCollection"
        },
        {
          "when": "view == collections && viewItem == collection",
          "command": "liteclient.renameCollection",
          "group": "1_modification"
        },
        {
          "when": "view == collections && viewItem == collectionRequest",
          "command": "liteclient.renameCollectionRequest",
          "group": "1_modification"
        },
        {
          "when": "view == collections && viewItem == collectionRequest",
          "command": "liteclient.deleteRequestFromCollection"
        },
        {
          "when": "view == environments && viewItem == environment",
          "command": "liteclient.deleteEnvironment"
        },
        {
          "when": "view == environments && viewItem == environment",
          "command": "liteclient.renameEnvironment",
          "group": "1_modification"
        },
        {
          "when": "view == environments && viewItem == environment",
          "command": "liteclient.addVariableToEnvironment",
          "group": "1_modification"
        },
        {
          "when": "view == requests && viewItem == historyItem",
          "command": "liteclient.deleteHistoryItem",
          "group": "inline"
        },
        {
          "when": "view == requests && viewItem == historyItem",
          "command": "liteclient.deleteHistoryItem"
        },
        {
          "when": "view == environments && viewItem == variable",
          "command": "liteclient.deleteVariable"
        },
        {
          "when": "view == environments && viewItem == variable",
          "command": "liteclient.editVariable",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "check": "npm run check:extension && npm run check:webview",
    "check:extension": "tsc -p ./ --noEmit",
    "check:webview": "tsc -p src/webview/tsconfig.json --noEmit",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "lit": "^3.3.2"
  }
}
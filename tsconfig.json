{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": false
	},
	"exclude": [
		"src/webview/**/*"
	],
	"references": [
		{
			"path": "./src/webview"
		}
	]
}
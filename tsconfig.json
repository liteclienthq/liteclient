{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": false
	},
	"include": [
		"src/extension/**/*",
		"src/shared/**/*"
	],
	"exclude": [
		"src/webview/**/*"
	]
}
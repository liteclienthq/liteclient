{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "outDir": "../../dist/webview",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "sourceMap": true,
        "strict": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "skipLibCheck": true,
        "composite": true
    },
    "include": [
        "**/*"
    ]
}